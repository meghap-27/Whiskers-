# Streamlit Community Cloud: paste this (with real values) into
# App settings -> Secrets. Locally, copy to .streamlit/secrets.toml (git-ignored) or use .env.
PUBLIC_MODE = "true"
LLM_PROVIDER = "groq"
GROQ_API_KEY = "gsk_..."
# optional backup when Groq's free tier is busy
GEMINI_API_KEY = ""
# limits for the shared key
QUESTIONS_PER_HOUR = "15"
DAILY_QUESTION_CAP = "300"
# optional crash reports (free tier at sentry.io)
SENTRY_DSN = ""
