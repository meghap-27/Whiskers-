# Copy to .env (never commit .env). Pick ONE provider; the free ones need no credit card.
# groq | gemini | ollama | anthropic
LLM_PROVIDER=groq

# Groq (free): https://console.groq.com/keys
GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini (free tier): https://aistudio.google.com/apikey
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-3.8-flash

# Ollama (free, runs on your PC): install from https://ollama.com, then `ollama pull qwen2.5:7b`
# OLLAMA_MODEL=qwen2.5:7b

# Claude (paid API credits): https://platform.claude.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5

AGENT_MAX_STEPS=8

# --- production / public deployment (see README "Deploy") ---
# PUBLIC_MODE=true          # turns off run_python, scopes glossary/pins per visitor, enables question limits
# ALLOW_PYTHON=false
# QUESTIONS_PER_HOUR=15
# DAILY_QUESTION_CAP=300
# MAX_UPLOAD_MB=20
# MAX_ROWS=200000
# SESSION_TTL_MIN=120
# RUN_TIMEOUT_S=120
# SENTRY_DSN=
